source "https://rubygems.org"

# Pins Jekyll and all plugins to the versions GitHub Pages builds with.
# See https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# No longer bundled with Ruby 3.x, needed by `jekyll serve`.
gem "webrick"
